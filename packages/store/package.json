{
    "name": "@sigx/store",
    "version": "0.8.0",
    "description": "Store framework for SignalX - State management abstraction",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./persist": {
            "types": "./dist/persist.d.ts",
            "development": "./dist/persist.js",
            "production": "./dist/persist.prod.js",
            "import": "./dist/persist.js"
        },
        "./ssr": {
            "types": "./dist/ssr.d.ts",
            "development": "./dist/ssr.js",
            "production": "./dist/ssr.prod.js",
            "import": "./dist/ssr.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "store",
        "state-management",
        "reactive"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/store.git",
        "directory": "packages/store"
    },
    "homepage": "https://sigx.dev/store/",
    "bugs": {
        "url": "https://github.com/signalxjs/store/issues"
    },
    "devDependencies": {
        "@sigx/reactivity": "^0.10.0",
        "@sigx/runtime-core": "^0.10.0",
        "@sigx/server-renderer": "^0.10.0",
        "@sigx/vite": "^0.10.0",
        "@types/node": "^25.9.1",
        "sigx": "^0.10.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/reactivity": ">=0.5.0 <0.11.0",
        "@sigx/runtime-core": ">=0.5.0 <0.11.0"
    }
}
