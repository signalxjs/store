{
    "name": "@sigx/store",
    "version": "0.6.1",
    "description": "Store framework for SignalX - State management abstraction",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./persist": {
            "import": "./dist/persist.js",
            "types": "./dist/persist.d.ts"
        },
        "./ssr": {
            "import": "./dist/ssr.js",
            "types": "./dist/ssr.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsgo",
        "dev": "tsgo --watch"
    },
    "keywords": [
        "sigx",
        "store",
        "state-management",
        "reactive"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/store.git",
        "directory": "packages/store"
    },
    "homepage": "https://sigx.dev/store/",
    "bugs": {
        "url": "https://github.com/signalxjs/store/issues"
    },
    "devDependencies": {
        "@sigx/reactivity": "^0.6.3",
        "@sigx/runtime-core": "^0.6.3",
        "@sigx/server-renderer": "^0.6.3",
        "@types/node": "^25.9.1",
        "sigx": "^0.6.3",
        "typescript": "^6.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/reactivity": ">=0.5.0 <0.7.0",
        "@sigx/runtime-core": ">=0.5.0 <0.7.0"
    }
}
